<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.2.1">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="wlt perfomance test" enabled="true">
      <stringProp name="TestPlan.comments"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="edit_verse_loop_count" elementType="Argument">
            <stringProp name="Argument.name">edit_verse_loop_count</stringProp>
            <stringProp name="Argument.value">7</stringProp>
            <stringProp name="Argument.desc">number of verse context edit request to be performed by each user</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="change_verse_status_loop_count" elementType="Argument">
            <stringProp name="Argument.name">change_verse_status_loop_count</stringProp>
            <stringProp name="Argument.value">5</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">number of verse status change request to be performed by each user</stringProp>
          </elementProp>
          <elementProp name="domain" elementType="Argument">
            <stringProp name="Argument.name">domain</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">domain where service can be run</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">8080</stringProp>
            <stringProp name="Argument.desc">port on which service is running </stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="10mb" elementType="Argument">
            <stringProp name="Argument.name">10mb</stringProp>
            <stringProp name="Argument.value">/home/ruslan/Documents/10mb.pdf</stringProp>
            <stringProp name="Argument.desc">path to file with 10 mb (tested with pdf file),  example https://cartographicperspectives.org/index.php/journal/article/view/cp13-full/pdf</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="30mb" elementType="Argument">
            <stringProp name="Argument.name">30mb</stringProp>
            <stringProp name="Argument.value">/home/ruslan/Documents/32mb.pdf</stringProp>
            <stringProp name="Argument.desc">path to file with 30 mb size  https://cartographicperspectives.org/index.php/journal/article/view/cp50-issue/pdf   </stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="50mb" elementType="Argument">
            <stringProp name="Argument.name">50mb</stringProp>
            <stringProp name="Argument.value">/home/ruslan/Documents/53mb.pdf</stringProp>
            <stringProp name="Argument.desc">path to file with 50 mb size  http://www.ubicomp.org/ubicomp2003/adjunct_proceedings/proceedings.pdf</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="90mb" elementType="Argument">
            <stringProp name="Argument.name">90mb</stringProp>
            <stringProp name="Argument.value">/home/ruslan/Documents/90mb.pdf</stringProp>
            <stringProp name="Argument.desc">path to file with 90 mb size https://ia800508.us.archive.org/22/items/Printed_Web_3/Printed_Web_3.pdf </stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
